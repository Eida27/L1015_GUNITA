# Deny by default. Only reproducible build inputs can reach any image stage.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.ts
!next-env.d.ts
!tsconfig.json
!postcss.config.mjs
!scripts/
!scripts/**
!src/
!src/**
!public/
!public/**
!assets/
!assets/**
!locales/
!locales/en.json
!locales/fil.json

# Never admit private configuration or key material through allowed directories.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/*.pfx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/secrets
**/.secrets
**/*.gunitabackup
**/*.gunitabackup.*
**/*.dump
**/*.backup
**/*.sql.gz

# Host dependencies, generated assets and local state are rebuilt or unnecessary.
public/maps/generated/
**/node_modules
**/.pnpm-store
**/.next
**/.cache
**/.turbo
**/.git
**/.local
**/.superpowers
**/.worktrees
**/worktrees
**/coverage
**/.nyc_output
**/playwright-report
**/blob-report
**/test-results
**/playwright/.auth
**/playwright/.cache

# Keep runtime diagnostics, editor files and temporary output out of every stage.
**/*.log
**/*.log.*
**/*.tsbuildinfo
**/*.heapsnapshot
**/*.heapprofile
**/*.stackdump
**/report.[0-9]*.json
**/.idea
**/.vscode
**/*.tmp
**/*.temp
**/*.bak
**/*.orig
**/*.rej
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/._*
**/[Tt]humbs.db
**/[Dd]esktop.ini
