# Reference only. pnpm setup generates bootstrap settings; pnpm db:prepare
# replaces DATABASE_URL with a random gunita_app URL and creates private .env.db.
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
DB_PORT=55435
POSTGRES_PASSWORD=GENERATED_BY_PNPM_SETUP
DATABASE_URL=postgresql://gunita:GENERATED_BY_PNPM_SETUP@127.0.0.1:55435/gunita
BETTER_AUTH_SECRET=GENERATED_BY_PNPM_SETUP
SMTP_HOST=127.0.0.1
SMTP_PORT=1028
MAILPIT_UI_PORT=8028
# Web must receive only runtime credentials in production. Operator commands use
# a separate MIGRATION_DATABASE_URL; bootstrap URL is for the operator alone.
# Optional local sender; Mailpit accepts it without real credentials.
# SMTP_FROM=Gunita <hello@gunita.test>
# Production SMTP may additionally need SMTP_SECURE=true and SMTP_USER/SMTP_PASSWORD.
# Production-only values; actual provider delivery/licensing remain launch gates.
# SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
# TURNSTILE_SECRET_KEY=REPLACE_WITH_PRODUCTION_SECRET
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_SITE_KEY
# MAP_STYLE_URL=REPLACE_WITH_LICENSED_HTTPS_STYLE
# LOCAL_PREVIEW=true permits a loopback-only production build smoke test.
# Local development/LOCAL_PREVIEW defaults to these public official test keys.
# Actual Siteverify is still called; these keys do not establish human validity.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TRUST_PROXY=direct (the only supported mode; forwarding headers are ignored)
# Optional validated local reverse proxy (configure APP_ORIGIN intentionally):
# LOCAL_PROXY=true
# CONTAINER_PREVIEW is reserved for the isolated loopback-Caddy rehearsal.
# Do not set it for ordinary host preview or real production.
# Optional HTTPS tile/font/sprite resource origins for the configured production style:
# MAP_RESOURCE_ORIGINS=https://tiles.example.invalid https://fonts.example.invalid
# Operator-only backup variables (never give these to the web process):
# BACKUP_DATABASE_URL=REPLACE_WITH_PRIVATE_OPERATOR_URL
# BACKUP_DESTINATION=C:/private-external-archives
# BACKUP_DESTINATION_KIND=local-simulation
# BACKUP_KEY_FILE=C:/private-separate-keys/gunita.key
# BACKUP_RETENTION_DAYS=7
# BACKUP_PG_CONTAINER=gunita-db-1
# RESTORE_OPERATOR_DATABASE_URL=REPLACE_WITH_ISOLATED_OPERATOR_URL
# RESTORE_RUNTIME_ROLE=gunita_app
# BACKUP_ARCHIVE=C:/private-external-archives/REPLACE_WITH_ARCHIVE.gunitabackup
# See docs/operations/backups.md for private paths, quarantine and reconciliation.
# Production uses infra/production.env.example plus separate service secret files.
