{
    admin off
    auto_https disable_redirects
    skip_install_trust
    log {
        output discard
    }
}
https://localhost {
    tls internal
    reverse_proxy web:3000 {
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
        header_up -Forwarded
        header_up X-Forwarded-For ""
    }
}
http://:8080 {
    respond /health "ok" 200
}
