# Paths only: secrets themselves are separate private files, never Compose interpolation.
GUNITA_SECRETS_DIR=/srv/gunita/secrets
BACKUP_ARCHIVE_PATH=/mnt/gunita-offsite
APP_HOST=gunita.example.invalid
APP_ORIGIN=https://gunita.example.invalid
TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_PUBLIC_SITE_KEY
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Gunita <hello@example.invalid>
MAP_STYLE_URL=https://example.invalid/licensed-style.json
MAP_RESOURCE_ORIGINS=https://example.invalid
CADDY_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
