{
  "name": "gunita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "local": "node scripts/local.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-map-assets.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d --wait db mailpit",
    "services:down": "docker compose down",
    "db:prepare": "node scripts/db.mjs prepare",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed:geo": "node scripts/db.mjs seed",
    "maintenance:expire": "node scripts/db.mjs expire",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.11",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "h3-js": "4.5.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.11",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
